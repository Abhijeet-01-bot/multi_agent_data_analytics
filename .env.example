@'
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Update this path for your environment.
DATABASE_URL=sqlite:///database/northwind.db

MAX_SQL_RETRIES=2
'@ | Set-Content -Encoding UTF8 .env.example

MCP_ENABLED=false
MCP_FALLBACK_TO_DIRECT=true
MCP_TRANSPORT=stdio
MCP_SERVER_MODULE=mcp_servers.analytics_server
MCP_TIMEOUT_SECONDS=30